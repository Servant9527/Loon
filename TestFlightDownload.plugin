#!name=TestFlight区域限制解除
#!category=功能解锁
#!author=NobyDa
#!desc=该模块适用于更新TestFlight App时, 提示"APP不可用"问题.

[Script]
http-request ^https?:\/\/testflight\.apple\.com\/v\d\/accounts\/.+?\/install$ script-path=https://gist.githubusercontent.com/NobyDa/9be418b93afc5e9c8a8f4d28ae403cf2/raw/TF_Download.js, requires-body=true, tag=TF下载修正, enabled=true

[MITM]
hostname = %APPEND% testflight.apple.com
