#!name=Keep去广告
#!desc=移除开屏广告、搜索推荐和弹窗广告，精简底栏和首页标签。移除关注推荐、文章相关推荐和信息流中的课程推广。
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/Keep.png
#!category=去广告
#!date=2026-10-02 13:57:49

[Mitm]
hostname =  api.gotokeep.com

[Rewrite]
(?i)^https:\/\/api\.gotokeep\.com\/op-engine-webapp\/v1\/ad\/ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.gotokeep\.com\/search\/v6\/default\/keyword\/list\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.gotokeep\.com\/twins\/v4\/feed\/followPage\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.gotokeep\.com\/twins\/union\/feed\/function\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.gotokeep\.com\/guide-webapp\/v1\/popup\/getPopUp\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.gotokeep\.com\/search\/v5\/hotCourse\/list$ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.gotokeep\.com\/search\/v4\/hotHashtag\/list$ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.gotokeep\.com\/search\/v4\/hotword\/list\? mock-response-body data-type=text data="{}" status-code=200

[Rule]
DOMAIN,kad.gotokeep.com,REJECT

# [Body Rewrite] Loon 无直接对应，需用脚本实现:
(?i)^https:\/\/api\.gotokeep\.com\/op-engine-webapp\/v1\/configs$ response-body-json-jq 'delpaths([["data","adTimeoutReport"]])'
(?i)^https:\/\/api\.gotokeep\.com\/op-engine-webapp\/v1\/configs$ response-body-json-jq 'delpaths([["data","spotShowReport"]])'
