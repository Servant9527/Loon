(?i)^https:\/\/api\.gotokeep\.com\/op-engine-webapp\/v1\/configs$ response-body-json-jq 'delpaths([["data","pugcStepMaxSeconds"]])'
(?i)^https:\/\/api\.gotokeep\.com\/op-engine-webapp\/v1\/configs$ response-body-json-jq 'delpaths([["data","pugcPreLoadEarlySeconds"]])'
