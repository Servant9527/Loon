#!name=应用安装
#!category=工具
#!author=githubdulong
#!desc=App Store 低版本应用安装、已购下架应用安装

[Script]
http-request https://apple-api.com script-path=https://cdn.jsdelivr.net/gh/githubdulong/Script@master/AppleStoreAPI.js, requires-body=true, timeout=120, tag=应用接口, enabled=true
http-request https:\/\/xiaobai\.app script-path=https://cdn.jsdelivr.net/gh/githubdulong/Script@master/installapp.js, timeout=120, tag=应用安装, enabled=true

[MITM]
hostname = %APPEND%  apple-api.com, xiaobai.app
