#!name=前程无忧去广告
#!desc=移除开屏广告、弹窗、信息流推广、职位页面推广和各类横幅推广。
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/51Job.png
#!category=去广告
#!date=2026-10-02 13:57:49

[Mitm]
hostname =  appapi.51jobapp.com, cupid.51jobapp.com

[Rewrite]
(?i)^https:\/\/appapi\.51jobapp\.com\/api\/market\/get_launch\.php\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/cupid\.51jobapp\.com\/open\/operation\/get\/latest\/banner-list\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/cupid\.51jobapp\.com\/open\/51job-activities\/secJob\/queryHomeSecondConfigV2\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/detail\/sesame-competitive\/ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/job-detail\/user-rights\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/cupid\.51jobapp\.com\/open\/resume\/strategy\/resume-build\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\/ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\/getHomePagePopUp\? mock-response-body data-type=text data="{}" status-code=200

# [Body Rewrite] Loon 无直接对应，需用脚本实现:
(?i)^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/recommend\/job-tab-dynamic\? response-body-json-jq 'delpaths([["resultbody","adsTabFeeds"]])'
(?i)^https:\/\/cupid\.51jobapp\.com\/open\/user-task\/user\/task\/ response-body-json-jq 'delpaths([["resultbody","availableTaskList"]])'
(?i)^https:\/\/cupid\.51jobapp\.com\/open\/tab\/good-job\/modules\? response-body-json-jq 'delpaths([["resultbody","bannerList"]])'
