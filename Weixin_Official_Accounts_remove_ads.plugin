#!name=微信公众号去广告
#!desc=过滤微信公众号广告
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/Weixin.png
#!category=去广告
#!date=2026-10-02 13:57:49

[Mitm]
hostname =  mp.weixin.qq.com

[Rewrite]
(?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword mock-response-body data-type=text data="{}" status-code=200

[Rule]
DOMAIN-SUFFIX,wxs.qq.com,REJECT
