#!name=脚本转换
#!desc=https://script.hub
#!category=工具
#!arguments=Notify:开启通知
#!arguments-desc=Notify:\nScriptHub通知设置, 可选 开启通知, 关闭通知, 跟随链接


[Script]
http-request ^https?:\/\/script\.hub\/($|edit\/|reload) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/script-hub.js, timeout=300

http-request ^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Rewrite-Parser.js, timeout=300, argument=Notify={{{Notify}}}

http-request ^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/rule-parser.js, timeout=300, argument=Notify={{{Notify}}}

http-request ^https?:\/\/script\.hub\/convert\/ script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/script-converter.js, timeout=300


[Mitm]
hostname =  script.hub, *.script.hub

[General]
force-http-engine-hosts =  script.hub, *.script.hub
