[Script]
http-response "(?i)^https?:\/\/(www|m)\.baidu\.com\/?($|\?from=\w{8 9})", script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/BaiduSearchHomePage_remove_ads.js, requires-body=true


[Mitm]
hostname =  m.baidu.com, www.baidu.com
