#!name=京东去广告
#!author=RuCu6, Maasea
#!desc=移除京东开屏广告，精简我的页面产品推广。
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/JD.png
#!openUrl=https://apps.apple.com/app/id414245413
#!category=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

[Rule]
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT

[Script]
http-response (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome) script-path=https://cdn.jsdelivr.net/gh/mihoyo-typ/KeleeOne@Loon/Script/JD_remove_ads.js, requires-body=true, tag=移除京东广告, enabled=true

[Map Local]
(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.m.jd.com
