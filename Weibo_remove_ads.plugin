#!name=微博去广告
#!desc=过滤微博广告及去除各部分推广模块
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/Weibo.png
#!category=去广告
#!date=2026-10-02 13:57:49

[Script]
http-response (?i)^https:\/\/api\.weibo\.cn\/2\/(?:checkin\/show|client\/publisher_list|push\/active) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/groups\/allgroups\/v2\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/(?:cardlist|page) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/(?:container\/asyn|flowlist|flowpage) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/friendships\/(?:create|destroy) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/profile\/(?:container_timeline|dealatt|me|statuses\/tab|userinfo) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/shproxy\/chaohua\/discovery\/searchactive\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:comments_expand_child|container_detail_comment) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_detail\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:extend|show)\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/video\/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/!\/huati\/discovery_home_bottom_channels\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/direct_messages\/user_list\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/messageflow\/notice\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_timeline|finder)\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/api\.weibo\.cn\/2\/searchall\? script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

http-response (?i)^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/Weibo_remove_ads.js, requires-body=true

[Mitm]
hostname =  *.weibo.cn, *.weibo.com, weibo.com

[Rewrite]
(?i)^https:\/\/api\.weibo\.cn\/2\/(?:ug\/checkin\/list|push\/daily|push\/info) mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/photo\/info\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_positive|push_info) mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange) mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category) mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_discover|finder_nav_polling)\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/video\/redpacket\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/(?:search\/finder_nav_polling|sug\/list\/finderchange|was\/finder\/searchbarchange)\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/api\.weibo\.cn\/2\/video\/tiny_video_info_show\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php) mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead) mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead) mock-response-body data-type=text data="{}" status-code=200

[Rule]
DOMAIN-SUFFIX,uve.weibo.com,DIRECT
DOMAIN,huodong.weibo.cn,REJECT
DOMAIN-SUFFIX,biz.weibo.com,REJECT
