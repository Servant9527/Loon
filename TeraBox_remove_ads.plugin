#!name=TeraBox去广告
#!desc=移除开屏广告、应用内悬浮窗、弹窗广告及横幅广告。
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/TeraBox.png
#!category=去广告
#!date=2026-10-02 13:57:49


[Mitm]
hostname =  www.terabox.com



[Rewrite]
# MapLocal (需手动检查): (?i)^https:\/\/www\.terabox\.com\/adx\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/www\.terabox\.com\/api\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/www\.terabox\.com\/api\/page\/tips\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/www\.terabox\.com\/rest\/1\.0\/task\/common\/inttips\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"


[Rule]
DOMAIN,ymg-api.terabox.com,REJECT
