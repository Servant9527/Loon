# [Body Rewrite] Loon 无直接对应，需用脚本实现:
(?i)^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? response-body-json-jq 'delpaths([["result","dy_module","irregular_banner_dy"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? response-body-json-jq 'delpaths([["result","icon_set"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? response-body-json-jq 'delpaths([["result","search_bar_hot_query"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? response-body-json-jq 'delpaths([["result","dy_module","irregular_banner_dy"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? response-body-json-jq '.result.bottom_tabs? |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) | .result.buffer_bottom_tabs? |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) | .result.all_top_opts |= map(del(.selected_image, .image, .height, .width))'
(?i)^https:\/\/api\.pinduoduo\.com\/search\? response-body-json-jq 'delpaths([["expansion"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? response-body-json-jq 'delpaths([["monthly_card_entrance"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? response-body-json-jq 'delpaths([["personal_center_style_v2_vo"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? response-body-json-jq 'delpaths([["icon_set","icons"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? response-body-json-jq 'delpaths([["icon_set","top_personal_icons"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? response-body-json-jq 'delpaths([["personal_banner"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? response-body-json-jq 'delpaths([["bottom_section_list"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? response-body-json-jq 'delpaths([["ui","bottom_section"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? response-body-json-jq 'delpaths([["ui","live_section","float_info"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\? response-body-json-jq 'delpaths([["data","goods_list"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/order\/ response-body-json-jq 'delpaths([["marketing_banner_vo"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/order\/ response-body-json-jq 'delpaths([["shipping","banner_above_recommend"]])'
(?i)^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/order_list_v4\? response-body-json-jq '.orders |= map(.order_buttons |= map(del(.order_growth_tip)))'
