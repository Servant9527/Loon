[Script]
http-response (?i)^https:\/\/m\.pinduoduo\.net\/mdkd\/package\?from_app_scan script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/PinDuoDuo_remove_ads.js, requires-body=true

[Mitm]
hostname =  api.pinduoduo.com, m.pinduoduo.net

