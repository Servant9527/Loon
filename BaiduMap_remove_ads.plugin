#!name=百度地图去广告
#!desc=移除开屏广告、出行页面推广、周边页面推广、打车页面推广，精简我的页面。
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/BaiduMap.png
#!category=去广告
#!date=2026-10-02 13:57:49


[Mitm]
hostname =  afd.baidu.com, newclient.map.baidu.com, yongche.baidu.com, ecom.map.baidu.com



[Rewrite]
# MapLocal (需手动检查): (?i)^https:\/\/afd\.baidu\.com\/afd\/entry\?action=(update|query) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/yongche\.baidu\.com\/gomarketing\/api\/popup\/getentrancecordovaurl$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/cobuild\/pull\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/operationgirdle$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/baseinfo$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/ecom\.map\.baidu\.com\/ad-ops\/afd\/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# MapLocal (需手动检查): (?i)^https:\/\/maphotel\.baidu\.com\/hotel\/goextranet\/activity\/detail\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"


# [Body Rewrite] Loon 无直接对应，需用脚本实现:
(?i)^https:\/\/newclient\.map\.baidu\.com\/feed\/govui\/rich_content response-body-json-jq 'delpaths([["data"]])'
(?i)^https:\/\/newclient\.map\.baidu\.com\/client\/noticebar\/get\? response-body-json-jq 'delpaths([["content","multi_data"]])'
(?i)^https:\/\/newclient\.map\.baidu\.com\/(client\/)?usersystem\/mine\/page\? response-body-json-jq 'if ((getpath([]) // {}) | has("data")) then (setpath(["data"]; "{}")) else . end'
(?i)^https:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?qt=ads&type=user_home_new_service response-body-json-jq 'delpaths([["ads"]])'
(?i)^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\? response-body-json-jq 'delpaths([["Result","cards",1]])'
(?i)^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\? response-body-json-jq 'delpaths([["Result","cards",4]])'
(?i)^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\? response-body-json-jq 'delpaths([["Result","cards",5]])'
(?i)^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\? response-body-json-jq 'delpaths([["Result","cards",9]])'
