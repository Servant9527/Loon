#!name=转转去广告
#!desc=移除开屏广告、应用内悬浮窗、信息流推广、商品推荐、首页弹窗，精简我的页面。
#!icon=https://cdn.jsdelivr.net/gh/luestr/IconResource@main/App_icon/120px/ZhuanZhuan.png
#!category=去广告
#!date=2026-10-02 13:57:49

[Mitm]
hostname =  app.zhuanzhuan.com

[Rewrite]
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/getOpenScreen$ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzinfoshow\/getwindvanecardv2$ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zzopen\/popwindow\/getallpopwin\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zzopen\/zzbmlogic\/queryFrontPageWindowInfo\? mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zzopen\/ptuserlogic\/subscribehotrecommend$ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zzopen\/ptsimpleshow\/recommendbymyloveinfo\? mock-response-body data-type=text data="{\"respCode\":0,\"errorMsg\":\"null\",\"errMsg\":\"\"}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzinfoshow\/footprintsamerecommend\? mock-response-body data-type=text data="{\"respCode\":0,\"errorMsg\":\"\",\"errMsg\":\"\"}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zzopen\/ypmall\/listData$ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzusercenter\/myprofilevariouscards$ mock-response-body data-type=text data="{}" status-code=200

(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzinfoshow\/getchoicegoodsinfos\? mock-response-body data-type=text data="{\"respCode\":0,\"respData\":{},\"errorMsg\":\"\",\"errMsg\":\"\"}" status-code=200

# [Body Rewrite] Loon 无直接对应，需用脚本实现:
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/mycontinenthomepage\? response-body-json-jq 'delpaths([["respData","topOpera","leftOpera"]])'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/mycontinenthomepage\? response-body-json-jq 'delpaths([["respData","topOpera","rightOpera2"]])'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/mycontinenthomepage\? response-body-json-jq 'delpaths([["respData","topActBanner"]])'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzlogic\/mycontinenthomepage\? response-body-json-jq 'delpaths([["respData","bmArea"]])'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zzx\/transfer\/getConfigInfo\? response-body-json-jq 'delpaths([["respData","freeMarketTabLeadPop"]])'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zzx\/transfer\/getConfigInfo\? response-body-json-jq 'delpaths([["respData","topOperations"]])'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/v2\/zzinfoshow\/getfeedflowinfo\? response-body-json-jq 'if .respData.userRed.campName == "OCD挂件" then del(.respData.userRed) else . end | .respData.infoData |= map(del(.rotateResource,.appRecommendResource,."cargoGroupCardV2"))'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmymoretools$ response-body-json-jq 'walk(if type == "object" and .name == "免流量特权" then empty else . end) | del(.respData.groupList[] | select(.groupName == "活动参与" or .groupName == "金融工具"))'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmyprofilev3$ response-body-json-jq 'delpaths([["respData","bmNewInfo"]])'
(?i)^https:\/\/app\.zhuanzhuan\.com\/zz\/transfer\/getmyprofilev3$ response-body-json-jq 'del(.respData.itemGroupList[].itemList[] | select(.name == "天天赚钱" or .name == "借钱")) | del(.respData.itemGroupList[] | select(.groupType == 15))'
