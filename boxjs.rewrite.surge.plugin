[Script]
http-request ^https?:\/\/(.+\.)?boxjs\.(com|net) script-path=https://raw.githubusercontent.com/Servant9527/Loon/main/JS%20folder/chavy.boxjs.js, requires-body=true, timeout=120

[Mitm]
hostname =  boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
